# Copy this file to .env.local and fill the values manually.
# Never commit secret values.
#
# The URL and publishable key are used by the browser Supabase client.
# NEXT_PUBLIC_ values are visible to the browser and must never contain secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Server-only. Never add a NEXT_PUBLIC_ prefix to the service-role key.
SUPABASE_SERVICE_ROLE_KEY=

# StudyDate ID outbound email (magic links). Never uses Supabase Auth mailer.
# Prefer Resend OR SMTP. From address should be a StudyDate domain identity.
STUDYDATE_EMAIL_FROM="StudyDate ID <noreply@your-domain.com>"
# Option A — Resend
STUDYDATE_RESEND_API_KEY=
# Option B — SMTP (e.g. Gmail app password / transactional SMTP)
STUDYDATE_SMTP_HOST=
STUDYDATE_SMTP_PORT=587
STUDYDATE_SMTP_SECURE=false
STUDYDATE_SMTP_USER=
STUDYDATE_SMTP_PASSWORD=

# Server-only encryption and keyed duplicate detection for Student Verification.
# Each value must decode to exactly 32 bytes (256 bits). Use standard Base64
# or exactly 64 hexadecimal characters. Malformed values fail closed at runtime.
STUDENT_VERIFICATION_ENCRYPTION_KEY=
STUDENT_VERIFICATION_HMAC_KEY=

# Server-only AES-256-GCM key for Contact Reveal contact values.
# Must decode to exactly 32 bytes. Never expose with a NEXT_PUBLIC_ prefix.
# Distinct from Student Verification keys — do not reuse those secrets.
CONTACT_REVEAL_ENCRYPTION_KEY=
# Optional positive integer for the current writing key version (default 1).
# Stored on each ciphertext row as encryption_key_version.
CONTACT_REVEAL_KEY_VERSION=1
# Optional prior keys during rotation only: CONTACT_REVEAL_ENCRYPTION_KEY_V1, _V2, …
# Keep every version that still has live ciphertext. Never commit values.

# Event Blast remains hidden until its migration and live authorization checks pass.
# Server-only. Do not use a NEXT_PUBLIC_ prefix.
EVENT_BLAST_ENABLED=false

# Server-only HMAC key for deterministic Campus Event QR tickets.
# Must decode to exactly 32 bytes from Base64 or be exactly 64 hexadecimal characters.
# Malformed or missing values fail closed. Never expose with NEXT_PUBLIC_.
EVENT_TICKET_SECRET=

# Verification remains disabled unless explicitly enabled after controlled testing.
STUDENT_VERIFICATION_ENABLED=false
# Optional comma-separated authenticated user UUIDs for controlled testing.
# Never use email addresses here and never commit real IDs to source control.
STUDENT_VERIFICATION_TEST_USER_IDS=
# Dedicated reviewer UUID. The account must also have the server-managed
# app_metadata.verification_reviewer flag set to true.
STUDENT_VERIFICATION_REVIEWER_USER_ID=

# Server-only secret used for manual evidence-cleanup invocations.
# Use at least 32 random characters.
STUDENT_VERIFICATION_CLEANUP_SECRET=
# Set true only after the Vercel Cron deployment and CRON_SECRET are configured.
STUDENT_VERIFICATION_CLEANUP_SCHEDULED=false

# Optional replaceable third-party academic lookup. Server-only and OFF by default.
# Base URL must be HTTPS and point to the provider's PDDIKTI student lookup endpoint.
PDDIKTI_LOOKUP_PROVIDER_ENABLED=false
PDDIKTI_PROVIDER_BASE_URL=
PDDIKTI_PROVIDER_ACCESS_KEY=

# Verified on LinkedIn. Server-only and disabled until the LinkedIn app has
# official Development/Lite product access. This supplements PDDikti; it never
# grants the StudyDate student badge by itself.
LINKEDIN_VERIFICATION_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://your-domain.com/api/verification/linkedin/callback
# Set from the current LinkedIn Verified API release notes for each endpoint.
LINKEDIN_IDENTITY_API_VERSION=
LINKEDIN_VERIFICATION_API_VERSION=
# Independent 32-byte HMAC key (Base64 or 64 hexadecimal characters).
LINKEDIN_MEMBER_HASH_KEY=

# Telegram Anonymous Chat Companion v1. Server-only and disabled by default.
# Do not configure the production webhook until migration + delivery runner approval.
TELEGRAM_COMPANION_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Telegram setWebhook secret_token, 32-256 characters from A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=
# Dedicated 32-byte keys. Never reuse Contact Reveal or Verification keys.
TELEGRAM_COMPANION_ENCRYPTION_KEY=
TELEGRAM_COMPANION_HMAC_KEY=
TELEGRAM_COMPANION_KEY_VERSION=1
# Historical rotation keys: TELEGRAM_COMPANION_ENCRYPTION_KEY_V1, _V2, …
# Vercel Cron bearer secret for the protected delivery runner. At least 32 random characters.
CRON_SECRET=

# AutoGoPay GoPay QRIS billing. Server-only and disabled by default.
# Rotate any key ever shared in chat; configure the replacement out-of-band.
AUTOGOPAY_ENABLED=false
AUTOGOPAY_API_KEY=

# Enable only after 202610170002_event_series_v2.sql is applied and verified.
EVENT_SERIES_ENABLED=false

# Ticket sales stay hidden until migration, RLS and checkout tests pass.
# Server-only. Paid orders also require a separately verified payment provider.
EVENT_TICKETING_ENABLED=false

# Paid checkout remains unavailable until one provider adapter and webhook are verified.
EVENT_TICKET_PAYMENTS_ENABLED=false
